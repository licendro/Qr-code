# Copie ce fichier en .env puis remplis-le :  cp .env.example .env
# Port d'écoute de l'app
PORT=3000
# Mot de passe ADMIN (accès illimité, réservé au premier téléphone qui s'en sert)
APP_PASSWORD=change-moi
# Facultatif : clé API Anthropic pour lire l'étiquette entière (numéro FR, nom, prénom, infos).
# Sans clé, l'app lit seulement le numéro FR et le téléphone avec une lecture locale (moins précise).
ANTHROPIC_API_KEY=
# Seulement si la clé n'est rattachée à aucun workspace (erreur « not scoped to a workspace ») : ID du workspace (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Modèle de lecture (Sonnet = le plus fiable). Option économie : ANTHROPIC_MODEL=claude-haiku-5-5 + ANTHROPIC_MODEL_FIABLE=claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Ton nom dans le message WhatsApp
SIGNATURE=Julien MERCERON

# Cagnotte commune (Stripe, sans bénéfice) — clé RESTREINTE rk_… (Checkout Sessions : écriture) + secret du webhook whsec_…
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
BASE_URL=https://colis.jdev-hub.fr
# 2 € minimum, 10 € maximum par personne, paiements bloqués quand la cagnotte atteint 20 €
MIN_RECHARGE_CENTIMES=200
PLAFOND_PERSONNE_CENTIMES=1000
PLAFOND_CAGNOTTE_CENTIMES=2000

# Mode privé : 1 = seul ton iPhone (appareil admin) a accès, les autres voient « Voir avec le propriétaire du site ».
# Se change aussi depuis le panneau admin (le choix du panneau prime).
MODE_PRIVE=1
